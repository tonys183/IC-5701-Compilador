main() : Int {
   b : list<list<Int>>;
   for (i : Int; in [1..10]) {
     a : list<Int>;
     for (j : Int; in [1..10]) {
        a.push(i=j);
     }
     b.push(a);
   }

   for (i : Int; in [1..10]) {
        for (j : Int; in [1..10]) {
           print(b[i-1][j-1]);
        }
   }
   return 0;
}