burbuja(lista:Int[], n:Int) : Int[]{
    for(i:Int; in [0 .. n-1]){
        for(j:Int; in [0 .. n-2-i]){
            if(lista[j] > lista[j+1]) {
                temp : Int := lista[j];
                lista[j] := lista[j+1];
                lista[j+1] := temp;
            }
        }
    }
    return lista;
}

main() : Int {
    lista : Int[7] := [64, 34, 25, 12, 22, 11, 90];
    n : Int := 7;
    sortedList : Int[7] := burbuja(lista, n);
    for(i:Int; in [0 .. n-1]){
        print(sortedList[i]);
    }
    return 0;
}