palindromo(s:String, n:Int) : Int {
  for (i : Int; in [0..n/2]) {
    if (~(s[i] = s[n-i-1])) {
      return 0;
    }
  } return 1;
}

main() : Int {
    s : String := "anitalavalatina";
    n : Int := 15;
    if (palindromo(s, n) = 1) {
        print("La cadena "); print(s); print("es un palíndromo.");
    } else {
        print("La cadena "); print(s); print("no es un palíndromo.");
    }
    return 0;
}